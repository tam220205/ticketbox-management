APP_NAME=Laravel
ADMIN_EMAIL=ktao5002@gmail.com
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# For Gmail SMTP fallback, use smtp.gmail.com:587, MAIL_SCHEME=tls,
# MAIL_USERNAME=your Gmail address, and MAIL_PASSWORD=your 16-character App Password.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_MAPS_EMBED_KEY=
OPENWEATHER_API_KEY=

# Ticket payment receiving account (never put gateway secrets in source control)
MB_ACCOUNT_NO=
MB_ACCOUNT_HOLDER=

# VietQR destination account (set these to the bank linked in SePay)
BANK_CODE=MB
BANK_NAME=MB Bank
BANK_FULL_NAME=Ngân hàng TMCP Quân đội
BANK_ACCOUNT_NO="${MB_ACCOUNT_NO}"
BANK_ACCOUNT_HOLDER="${MB_ACCOUNT_HOLDER}"

# SePay bank-transfer auto confirmation (requires a public HTTPS webhook URL).
# Leave false until fully configured; checkout is blocked while disabled.
SEPAY_ENABLED=false
SEPAY_WEBHOOK_API_KEY=
SEPAY_PAYMENT_TIMEOUT_MINUTES=15

# Local/testing only. This simulates payment and must remain false in production.
PAYMENT_DEMO_MODE=false

# Google OAuth (optional; keep credentials in your private .env)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Google Drive image storage. OAuth credentials access a personal My Drive folder;
# Service Account credentials are kept for Shared Drive deployments.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=storage/app/google/service-account.json
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=

# Gmail API ticket delivery (OAuth refresh token; otherwise use SMTP)
GMAIL_API_ENABLED=false
GMAIL_SENDER_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
